{
  "name": "scrs-backend",
  "version": "1.0.0",
  "description": "Student Course Registration System backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed --seed 20260926000001-roles-and-admin.cjs && sequelize-cli db:seed --seed 20260930000002-essential-settings.cjs",
    "db:seed:demo": "sequelize-cli db:seed:all",
    "admin:create": "node scripts/create-admin.mjs",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "NODE_ENV=test node --test \"tests/unit/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.30.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
