# Server
PORT=5000
NODE_ENV=development
# The frontend's exact origin(s), comma-separated if more than one. Sent back as
# Access-Control-Allow-Origin on credentialed requests, which is what lets the browser send the
# refresh cookie at all — get this wrong and login/refresh silently fail in the browser.
# In production this must be your real frontend origin(s) over https:// — no "*", no localhost.
# Recommended deployment: the frontend and this API as subdomains of one domain
# (e.g. https://app.university.edu talking to https://api.university.edu). Subdomains of the same
# domain are the same "site" for cookie purposes, so the refresh cookie's SameSite=Strict already
# works as-is across them — no cookie code changes needed, just set this correctly.
CORS_ORIGIN=http://localhost:5173
# The canonical frontend URL, used to build links in emails (e.g. the password-reset link).
# Must be https:// in production, same reasoning as CORS_ORIGIN above.
FRONTEND_URL=http://localhost:5173

# Database (MySQL). Tests use DB_NAME + "_test".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scrs
DB_USER=root
DB_PASSWORD=
# Required by most managed MySQL providers (Aiven, PlanetScale, ...). Leave false for local dev.
DB_SSL=false
# Optional: pins the provider's own CA cert instead of trusting Node's default CA list.
DB_SSL_CA=

# JWT (use long random strings, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Security
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=30
# How long a set-your-password invite link (staff-created and imported accounts) stays valid.
INVITE_EXPIRES_HOURS=72
# How long the account-activation link emailed to an admitted online applicant stays valid.
ACTIVATION_EXPIRES_HOURS=72

# Email (activation, verification, password/PIN alerts, registration decisions, announcements...).
# Provider order: RESEND_API_KEY set -> Resend; else SMTP_HOST set -> that SMTP relay; else emails are
# logged instead of sent (development only). REQUIRED in production: the server refuses to start
# without RESEND_API_KEY (or SMTP_HOST) and a sender (EMAIL_FROM, or SMTP_FROM for SMTP).
# Never commit real values. Keep them in .env (gitignored) locally and in the host's environment
# settings (Render: service -> Environment) in production.
# Resend API key (Resend dashboard -> API Keys, "Sending access").
RESEND_API_KEY=
# Sender, e.g. "SCRS <no-reply@mail.yourschool.edu>", on a domain verified in Resend. Leave empty in
# development to use Resend's onboarding sender (onboarding@resend.dev): it only delivers to the email
# address of your own Resend account. The server refuses the onboarding sender in production.
EMAIL_FROM=
# Signing secret (whsec_...) of the Resend webhook for https://<api>/api/webhooks/resend. Without it the
# webhook answers 503, and the email log shows emails as "Accepted" but never "Delivered".
RESEND_WEBHOOK_SECRET=
# School name in email headers and subjects, used while the institution.name setting is still the default.
SCHOOL_NAME=
# SMTP alternative, only used when RESEND_API_KEY is empty. Any SMTP relay works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMTP sender, e.g. "Student Course Registration System <no-reply@example.edu>" (EMAIL_FROM wins if set).
SMTP_FROM=
# Development only (refused in production): when emails are only logged, token links show as
# token=[redacted]; set true to log them in full so you can click activation/reset links locally.
EMAIL_LOG_LINKS=false

# Domain of admitted students' school email (e.g. school.edu). The institution.studentEmailDomain
# setting (Staff → System settings) takes precedence; this is the fallback when that is empty.
SCHOOL_EMAIL_DOMAIN=

# Observability — both optional everywhere, including production. The app is fully functional
# without them; you just have less visibility if something breaks. Worth setting for a real
# deployment, but not something the server refuses to boot over.
# LOG_LEVEL: fatal | error | warn | info | debug | trace. Defaults to "debug" in development,
# "info" in production, "error" in test.
LOG_LEVEL=debug
# SENTRY_DSN: from your Sentry project's settings. With it set, unexpected errors (5xx responses,
# unhandled promise rejections, uncaught exceptions) are reported there, tagged with the same
# requestId shown in the API's error response and in the logs.
SENTRY_DSN=

# Seed admin
# In development these are optional (falls back to admin@scrs.local / Admin@12345).
# In production (NODE_ENV=production) both are REQUIRED, and the seeder refuses to run without
# them, refuses the value "Admin@12345" (it is published in this project's own docs), and requires
# at least 12 characters. Set real, unique values here before running `npm run db:seed` in production.
SEED_ADMIN_EMAIL=admin@unireg.com
SEED_ADMIN_PASSWORD=202026Uniregistration

# ─── Official application photos (object storage) ───────────────────────────
# The applicant's official admission photo is stored in a PRIVATE S3-compatible bucket (Cloudflare R2
# recommended) and only ever served through the API, after an authorisation check. Create a bucket and an
# API token with read+write on that bucket only. In development you can leave all of this unset: photos
# then go to ./storage on your machine. In production, with these unset, the photo routes answer 503 and
# /api/health reports storage: false, but the API still boots.
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
