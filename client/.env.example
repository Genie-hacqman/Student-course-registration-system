# Public facts about the institution and site. All optional: anything left blank is simply not shown on the pages.
# Set these in the Vercel project's Environment Variables for production (they are baked in at build time).

# Public origin of this frontend, no trailing slash. Needed for share previews (og:image), robots.txt and sitemap.xml.
VITE_SITE_URL=
# Name used in the privacy policy and terms ("operated by ...").
VITE_INSTITUTION_NAME=
# How people reach the registry. Shown in the footer, on the 404 page and on the legal pages.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_ADDRESS=

# Browser error tracking (Sentry). Leave blank to turn it off.
VITE_SENTRY_DSN=
